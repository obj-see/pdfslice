{
  "name": "pdfslice",
  "type": "module",
  "version": "1.1.0",
  "description": "Split, gather, and verify PDF <-> page-image sets",
  "author": "DuckyMomo20012",
  "license": "CC-BY-NC-SA-4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DuckyMomo20012/pdfslice.git"
  },
  "exports": {
    ".": {
      "types": {
        "import": "./dist/cli.d.mts",
        "require": "./dist/cli.d.cts"
      },
      "import": "./dist/cli.js",
      "require": "./dist/cli.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cli.cjs",
  "module": "./dist/cli.js",
  "types": "./dist/cli.d.mts",
  "bin": {
    "pdfslice": "./dist/cli.mjs",
    "__pdfslice_bash_complete": "./dist/bash-complete.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check-exports": "attw --pack . --ignore-rules=cjs-resolves-to-esm",
    "postinstall": "npx @stricli/auto-complete@latest install pdfslice --bash __pdfslice_bash_complete"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.1.0",
    "@stricli/auto-complete": "1.3.0",
    "@stricli/core": "1.3.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "sharp": "0.35.5",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "10.0.0",
    "@arethetypeswrong/cli": "0.18.5",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "26.6.6",
    "@vitest/eslint-plugin": "1.6.28",
    "@vitest/ui": "5.0.5",
    "eslint": "10.14.0",
    "eslint-plugin-format": "2.0.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "tsdown": "0.23.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
